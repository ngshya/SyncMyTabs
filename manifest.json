{
  "manifest_version": 3,
  "name": "SyncMyTabs",
  "version": "3.3.0",
  "description": "Sync your open tabs across devices, organized by profile, using bookmarks as the transport.",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["browser-polyfill.min.js", "sync-core.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SyncMyTabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "syncmytabs@shuyi.it",
      "strict_min_version": "128.0"
    }
  }
}
